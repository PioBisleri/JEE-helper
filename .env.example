# Nexus JEE — Frontend Environment Variables
# Copy this file to .env and fill in your values.
# .env is gitignored — never commit it.

# ─── Required (Production) ───

# Backend API URL. Use http://localhost:8000 for local dev.
VITE_API_URL=https://nexus-jee-api.onrender.com

# Google OAuth Web Client ID.
# Create at: https://console.cloud.google.com/apis/credentials
# Add Authorized JavaScript origins:
#   - http://localhost:5173
#   - https://<your-vercel-domain>.vercel.app
#   - https://<your-custom-domain> (if you have one)
VITE_GOOGLE_CLIENT_ID=

# ─── Optional ───

# OpenRouter API key. DEV-ONLY fallback for local testing.
# In production, each user supplies their own key (BYOK) which is
# encrypted server-side with Fernet. Do NOT set this in production.
VITE_OPENROUTER_KEY=
