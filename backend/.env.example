# Nexus JEE — Backend Environment Variables
# Copy this file to .env for local dev, or set these in your hosting provider
# (Render, Railway, Fly.io, etc.) for production.

# ─── Required ───

# Secret for signing JWT tokens. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=

# Key for encrypting user AI provider API keys at rest. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# ─── Google OAuth ───

# Same Client ID as the frontend's VITE_GOOGLE_CLIENT_ID.
# Used in backend/auth.py to verify the audience of incoming id_tokens.
VITE_GOOGLE_CLIENT_ID=

# ─── Optional ───

# SQLite database path. Defaults to backend/nexus_jee.db.
# In production on Render, use the persistent disk:
#   DATABASE_PATH=/opt/render/project/src/data/nexus_jee.db
DATABASE_PATH=

# Production frontend URL for CORS allowlist.
#   FRONTEND_ORIGIN=https://your-app.vercel.app
FRONTEND_ORIGIN=

# ─── Optional: Password Reset Email (SMTP) ───
# If not set, reset codes are printed to server logs (dev mode).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
